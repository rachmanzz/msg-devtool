{
  "manifest_version": 3,
  "name": "MessagePack DevTools",
  "version": "0.1.0",
  "description": "Intercept, decode, and inspect MessagePack (msgpack) network responses.",
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "msgpack-devtools@rachmanzz.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
