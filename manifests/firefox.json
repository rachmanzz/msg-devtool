{
  "manifest_version": 3,
  "name": "MessagePack DevTools",
  "description": "Intercept, decode, and inspect MessagePack (msgpack) network responses.",
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "msgpack-devtools@rachmanzz.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
